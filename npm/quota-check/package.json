{
  "name": "quota-check",
  "version": "0.2.0",
  "description": "Check Coding Agent quota usage (5h / weekly windows) — Codex, Claude Code, Kimi Code. Rust binary with a thin Node launcher.",
  "keywords": [
    "codex",
    "claude",
    "kimi",
    "quota",
    "rate-limit",
    "coding-agent",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erchoc/quota-check.git"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "quota-check": "bin/quota-check.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "lib/",
    "index.js"
  ],
  "optionalDependencies": {
    "quota-check-darwin-arm64": "0.2.0",
    "quota-check-darwin-x64": "0.2.0",
    "quota-check-linux-arm64": "0.2.0",
    "quota-check-linux-x64": "0.2.0",
    "quota-check-win32-x64": "0.2.0"
  }
}
